{
  "manifest_version": 3,
  "name": "Import to TeXposit",
  "version": "0.1.0",
  "description": "Adds an \"Import to TeXposit\" button to Google Scholar, ACM, arXiv, Springer, IEEE and other paper pages.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }, "default_title": "Import to TeXposit" },
  "permissions": ["tabs"],
  "host_permissions": ["https://app.texposit.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/*",
        "https://dl.acm.org/*",
        "https://arxiv.org/abs/*",
        "https://ieeexplore.ieee.org/*",
        "https://link.springer.com/*",
        "https://www.sciencedirect.com/*",
        "https://www.nature.com/*",
        "https://onlinelibrary.wiley.com/*",
        "https://pubs.acs.org/*",
        "https://journals.aps.org/*"
      ],
      "js": ["content.js"]
    }
  ]
}
